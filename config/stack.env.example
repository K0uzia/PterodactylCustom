# Copiez ce fichier vers stack.env et adaptez les valeurs :
#   cp config/stack.env.example config/stack.env
#
# Ne commitez JAMAIS stack.env (mots de passe / secrets).

# Domaine public du panel (hostname Cloudflare Tunnel)
PANEL_DOMAIN=panel.example.com

# Chemins
PANEL_DIR=/var/www/pterodactyl
WINGS_CONFIG_DIR=/etc/pterodactyl
BACKUP_DIR=/var/backups/ptero-stack
INSTALL_ROOT=/opt/ptero-stack

# Base de données MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=panel
DB_USER=pterodactyl
# Laissez vide pour génération automatique à l'install
DB_PASSWORD=

# PHP (Ubuntu 22.04 + PPA ondrej)
PHP_VERSION=8.3

# Rétention des backups (nombre de dossiers à conserver)
BACKUP_KEEP=7

# Timezone applicative (utilisée si configuration non-interactive possible)
APP_TIMEZONE=Europe/Paris

# Remplis automatiquement par le menu d'installation (optionnel)
# ADMIN_EMAIL=
# ADMIN_USERNAME=
# ADMIN_NAME=
# MAIL_MAILER=mail
